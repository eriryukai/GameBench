<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AvaloniaSplashScreenDemo.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="300"
        d:DesignHeight="300"
        x:DataType="vm:SplashScreenViewModel"
        Width="300"
        Height="300"
        WindowStartupLocation="CenterScreen"
        WindowDecorations="None"
        Topmost="True"
        x:Class="AvaloniaSplashScreenDemo.Views.SplashScreen"
        Title="SplashScreen">
    <Border BorderBrush="Black" BorderThickness="2" Background="#262626">
        <Grid RowDefinitions="*,Auto" ColumnDefinitions="*,Auto">
            <Image x:Name="LogoImage"
                   Grid.Row="0"
                   Grid.Column="0"
                   Grid.ColumnSpan="2"
                   Margin="20"
                   Stretch="Uniform"
                   IsVisible="False" />
            <Label Grid.Row="1"
                   Grid.Column="0"
                   Content="{Binding StartupMessage}"
                   FontSize="12"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Stretch"
                   HorizontalContentAlignment="Center"
                   VerticalContentAlignment="Center" />
            <Button Grid.Row="1"
                    Grid.Column="1"
                    Command="{Binding CancelCommand}">
                Cancel
            </Button>
        </Grid>
    </Border>
</Window>