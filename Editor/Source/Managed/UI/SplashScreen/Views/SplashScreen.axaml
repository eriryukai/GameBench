<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GameBench.Editor.Managed.UI.SplashScreen.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="440"
        d:DesignHeight="200"
        x:DataType="vm:SplashScreenViewModel"
        Width="440"
        Height="200"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        WindowDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        Topmost="True"
        x:Class="GameBench.Editor.Managed.UI.SplashScreen.Views.SplashScreen"
        Title="MortarEngine">
    <Grid RowDefinitions="*,Auto" Margin="28,22,28,16">
        <!-- Brand lockup: the white mark tinted brand red plus the wordmark as real text.
             Shadowed because the window itself has no background: it holds up on light desktops. -->
        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Spacing="20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
            <StackPanel.Effect>
                <DropShadowEffect BlurRadius="16" OffsetX="0" OffsetY="3" Opacity="0.8" Color="#000000" />
            </StackPanel.Effect>
            <Image Width="112"
                   Height="112"
                   Stretch="Uniform"
                   VerticalAlignment="Center"
                   Source="{Binding Mark}" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="MORTAR"
                           FontSize="42"
                           FontWeight="ExtraBold"
                           Foreground="White"
                           LineHeight="44" />
                <TextBlock Text="ENGINE"
                           FontSize="17"
                           FontWeight="SemiBold"
                           Foreground="White"
                           LetterSpacing="12"
                           Margin="1,0,0,0" />
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,14,0,0">
            <TextBlock Grid.Column="0"
                       Text="{Binding StartupMessage}"
                       FontSize="12"
                       Foreground="#C0C0C0"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center">
                <TextBlock.Effect>
                    <DropShadowEffect BlurRadius="10" OffsetX="0" OffsetY="2" Opacity="0.85" Color="#000000" />
                </TextBlock.Effect>
            </TextBlock>
            <Button Grid.Column="1"
                    Content="Cancel"
                    Command="{Binding CancelCommand}"
                    Padding="14,4"
                    FontSize="12" />
        </Grid>
    </Grid>
</Window>
