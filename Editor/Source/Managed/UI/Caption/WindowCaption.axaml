<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MortarEngine.Editor.Managed.UI.Caption"
             x:DataType="vm:WindowCaptionViewModel"
             x:Class="MortarEngine.Editor.Managed.UI.Caption.WindowCaption">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
        <Button Classes="caption"
                Width="46"
                Height="57"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Command="{Binding MinimizeCommand}"
                ToolTip.Tip="Minimize">
            <Border Width="10"
                    Height="1"
                    Background="{StaticResource EditorText}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" />
        </Button>

        <Button Classes="caption"
                Width="46"
                Height="57"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Command="{Binding ToggleMaximizeCommand}"
                ToolTip.Tip="{Binding MaximizeToolTip}">
            <Panel>
                <Border Width="10"
                        Height="10"
                        BorderBrush="{StaticResource EditorText}"
                        BorderThickness="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsVisible="{Binding !IsMaximized}" />
                <!-- Two offset squares, matching the OS "restore down" affordance. -->
                <Grid Width="12" Height="12" IsVisible="{Binding IsMaximized}">
                    <Border Width="8"
                            Height="8"
                            BorderBrush="{StaticResource EditorText}"
                            BorderThickness="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top" />
                    <Border Width="8"
                            Height="8"
                            BorderBrush="{StaticResource EditorText}"
                            BorderThickness="1"
                            Background="{StaticResource EditorTitleBar}"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Bottom" />
                </Grid>
            </Panel>
        </Button>

        <Button Classes="caption caption-close"
                Width="46"
                Height="57"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Command="{Binding CloseCommand}"
                ToolTip.Tip="Close">
            <Path Data="{Binding CloseIcon}"
                  Fill="{StaticResource EditorText}"
                  Width="12"
                  Height="12"
                  Stretch="Uniform"
                  Margin="4,0" />
        </Button>
    </StackPanel>
</UserControl>
