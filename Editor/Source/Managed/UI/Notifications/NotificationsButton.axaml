<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="using:GameBench.Editor.Managed.Core"
             xmlns:vm="using:GameBench.Editor.Managed.UI.Notifications"
             x:DataType="vm:NotificationsViewModel"
             x:Class="GameBench.Editor.Managed.UI.Notifications.NotificationsButton">
    <Button Classes="toolbar"
            VerticalAlignment="Center"
            Cursor="Hand"
            ToolTip.Tip="Notifications">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Path Data="{Binding BellIcon}"
                  Fill="{StaticResource EditorText}"
                  Width="14"
                  Height="14"
                  Stretch="Uniform"
                  Margin="4,0" />
            <TextBlock Text="{Binding CountText}"
                       VerticalAlignment="Center"
                       FontSize="11"
                       FontWeight="Bold"
                       Foreground="{StaticResource EditorAccent}"
                       IsVisible="{Binding HasNotifications}" />
        </StackPanel>
        <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedRight">
                <StackPanel Width="320" Spacing="6">
                    <TextBlock Text="Notifications"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{StaticResource EditorTextMuted}" />
                    <TextBlock Text="No notifications"
                               FontSize="12"
                               Foreground="{StaticResource EditorTextMuted}"
                               IsVisible="{Binding !HasNotifications}" />
                    <ScrollViewer MaxHeight="320" IsVisible="{Binding HasNotifications}">
                        <ItemsControl ItemsSource="{Binding Items}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="core:NotificationItem">
                                    <StackPanel Spacing="2" Margin="2,2,2,6">
                                        <TextBlock Text="{Binding Text}"
                                                   TextWrapping="Wrap" />
                                        <Button Classes="toolbar"
                                                Content="{Binding ActionLabel}"
                                                Command="{Binding Action}"
                                                IsVisible="{Binding HasAction}"
                                                HorizontalAlignment="Left"
                                                Padding="10,2"
                                                FontSize="11" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Button Classes="toolbar"
                            Content="Clear"
                            Command="{Binding ClearCommand}"
                            IsVisible="{Binding HasNotifications}" />
                </StackPanel>
            </Flyout>
        </Button.Flyout>
    </Button>
</UserControl>
